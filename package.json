{
  "name": "covitrack",
  "version": "1.0.0",
  "private": true,
  "description": "CoviTrack - COVID-19 Information & Testing Management System + Automated QA Framework",
  "scripts": {
    "install:all": "npm install && npm run install:client && npm run install:server",
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "db:migrate": "cd server && npm run db:migrate",
    "seed:admin": "cd server && npm run seed:admin",
    "seed:slots": "cd server && npm run seed:slots",
    "report:qa": "cd server && npm run report:qa",
    "test:automation": "cd automation && mvn clean test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

