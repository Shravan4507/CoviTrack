# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=covitrack

# Test Database (for QA Automation)
TEST_DB_NAME=covitrack_test

# Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Client Origin (CORS)
CLIENT_ORIGIN=http://127.0.0.1:5173

# Storage Directory for Generated Diagnostic Reports
STORAGE_DIR=../storage/reports

